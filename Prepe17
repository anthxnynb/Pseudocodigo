Algoritmo Tabla_de_multiplicar
    // Ejercicio: pseudocódigo Tabla de multiplicar con for
    // Fuente: ZIP original

    // Variables y datos del problema
    Definir K, I, R Como Entero
    // Entrada de datos y validaciones
    Escribir "Ingrese el numero entero para mostrar su tabla:"
    Leer K
    // Proceso y cálculos
    Para I <- 1 Hasta 10 Hacer
        R <- K * I
        Escribir K, " x ", I, " = ", R
    FinPara
FinAlgoritmo
