Algoritmo Punto_medio_y_distancia
    // Ejercicio: Punto medio y distancia entre dos puntos
    // Fuente: ZIP original

    // Variables y datos del problema
    Definir X1, Y1, X2, Y2, DIS, XM, YM Como Real

    // Entrada de datos y validaciones
    Escribir "Ingrese la coordenada x del primer punto:"
    Leer X1
    Escribir "Ingrese la coordenada y del primer punto:"
    Leer Y1
    Escribir "Ingrese la coordenada x del segundo punto:"
    Leer X2
    Escribir "Ingrese la coordenada y del segundo punto:"
    Leer Y2

    // Proceso y cálculos
    DIS <- RC((X2 - X1)^2 + (Y2 - Y1)^2)
    XM <- (X1 + X2) / 2
    YM <- (Y1 + Y2) / 2

    Escribir "Distancia entre los puntos: ", DIS
    Escribir "Punto medio: (", XM, ", ", YM, ")"
FinAlgoritmo
