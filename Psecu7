Algoritmo Triangulo_rectangulo
    // Ejercicio: Hipotenusa y área de un triángulo rectángulo
    // Fuente: ZIP original

    // Variables y datos del problema
    Definir A, B, H, AR Como Real

    // Entrada de datos y validaciones
    Escribir "Ingrese el primer cateto:"
    Leer A
    Escribir "Ingrese el segundo cateto:"
    Leer B

    // Proceso y cálculos
    Si A <= 0 O B <= 0 Entonces
        Escribir "Los catetos deben ser mayores que cero"
    SiNo
        H <- RC(A ^ 2 + B ^ 2)
        AR <- A * B / 2
        Escribir "Hipotenusa: ", H
        Escribir "Area: ", AR
    FinSi
FinAlgoritmo
