Algoritmo Tabla_de_multiplicar_mientras
    // Ejercicio: pseudocódigo tabla de multiplicacion con mientras
    // Fuente: ZIP original

    // Variables y datos del problema
    Definir K, I, R Como Entero
    // Entrada de datos y validaciones
    Escribir "Ingrese el numero entero para mostrar su tabla:"
    Leer K
    // Proceso y cálculos
    I <- 1
    Mientras I <= 10 Hacer
        R <- K * I
        Escribir K, " x ", I, " = ", R
        I <- I + 1
    FinMientras
FinAlgoritmo
