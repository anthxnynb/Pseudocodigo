Algoritmo Serie_armonica
    // Ejercicio: Suma de la serie armónica
    // Fuente: ZIP original

    // Variables y datos del problema
    Definir S Como Real
    Definir N, I Como Entero

    // Entrada de datos y validaciones
    Escribir "Ingrese N:"
    Leer N

    // Proceso y cálculos
    Si N <= 0 Entonces
        Escribir "N debe ser mayor que cero"
    SiNo
        S <- 0
        Para I <- 1 Hasta N Hacer
            S <- S + 1 / I
        FinPara
        Escribir "Suma de la serie: ", S
    FinSi
FinAlgoritmo
