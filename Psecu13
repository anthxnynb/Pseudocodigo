Algoritmo Area_Triangulo
    // Ejercicio: pseudocódigo área de un triangulo
    // Fuente: ZIP original

    // Variables y datos del problema
   Definir B,H,A como real
    // Entrada de datos y validaciones
  Escribir "Ingresar la base:"
   Leer B
  Escribir "Ingresar la altura:"
   Leer H
    // Proceso y cálculos
 A <- (B*H)/2
  Escribir "La area del triangulo es:" , A
FinAlgoritmo
