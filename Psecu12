Algoritmo Suma_Producto_Media
    // Ejercicio: pseudocódigo producto su suma y media Aritmetica
    // Fuente: ZIP original

    // Variables y datos del problema
   Definir N1,N2,N3,N4,S,P,M como real
    // Entrada de datos y validaciones
  Escribir "Ingrese el primer numero"
   Leer N1
  Escribir "Ingrese el segundo numero"
   Leer N2
  Escribir "Ingrese el trecer numero"
   Leer N3
  Escribir "Ingrese el cuarto numero"
   leer N4
    // Proceso y cálculos
 S <- N1+N2+N3+N4
 P <- N1*N2*N3*N4
 M <- S/4
  Escribir "La suma es:" , S
  Escribir "Es producto es:" , P
  Escribir "La media aritmetica es:" , M
FinAlgoritmo
