Algoritmo Invertir_numero
    // Ejercicio: Inversión de un número
    // Fuente: ZIP original

    // Variables y datos del problema
    Definir N, T, D, INV Como Entero

    // Entrada de datos y validaciones
    Escribir "Ingrese un numero entero positivo:"
    Leer N

    // Proceso y cálculos
    Si N <= 0 Entonces
        Escribir "El numero debe ser positivo"
    SiNo
        T <- N
        INV <- 0
        Mientras T > 0 Hacer
            D <- T MOD 10
            INV <- INV * 10 + D
            T <- Trunc(T / 10)
        FinMientras
        Escribir "Numero invertido: ", INV
    FinSi
FinAlgoritmo
